# Copy these values into Vercel Project Settings -> Environment Variables.
# Vercel proxies these relative paths through frontend/vercel.json.
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai

# Append ?ui-preview=1 to the Vercel URL to open the mock UI without backend requests.
# The normal URL connects to the configured backend and AI rewrites.

# Proxy destinations are temporary and are generated by scripts/start_demo_tunnel.ps1.
# If the tunnel restarts, run the script again and redeploy Vercel.
